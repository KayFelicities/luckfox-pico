/dts-v1/;

#include "rv1103.dtsi"
#include "rv1106-evb.dtsi"
#include "rv1103-luckfox-pico-ipc.dtsi"

/ {
	model = "Luckfox Pico Mini B";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1103";

    gpio3pa1:gpio3pa1 {
        compatible = "regulator-fixed";
        pinctrl-names = "default";
        pinctrl-0 = <&gpio3_pa1>;
        regulator-name = "gpio3_pa1";
        regulator-always-on;
    };
    gpio3pa2:gpio3pa2 {
        compatible = "ir_rx-fixed";
        pinctrl-names = "default";
        pinctrl-0 = <&gpio3_pa2>;
        regulator-name = "gpio3_pa2";
        regulator-always-on;
    };
    gpio3pa3:gpio3pa3 {
        compatible = "regulator-fixed";
        pinctrl-names = "default";
        pinctrl-0 = <&gpio3_pa3>;
        regulator-name = "gpio3_pa3";
        regulator-always-on;
    };
    gpio3pa5:gpio3pa5 {
        compatible = "regulator-fixed";
        pinctrl-names = "default";
        pinctrl-0 = <&gpio3_pa5>;
        regulator-name = "gpio3_pa5";
        regulator-always-on;
    };

    // for u-boot
	uboot-gpios {
		compatible = "uboot-gpios";
		u-boot,dm-pre-reloc;
		status = "okay";

		spi-cd = <&gpio1 RK_PD2 GPIO_ACTIVE_HIGH>;
		spi-reset = <&gpio1 RK_PD3 GPIO_ACTIVE_HIGH>;
		led-red = <&gpio3 RK_PA3 GPIO_ACTIVE_HIGH>;
		led-green = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>;
	};
};

/**********GPIO**********/
&pinctrl {
    gpio3-pa1 {
        gpio3_pa1:gpio3-pa1 {
            rockchip,pins = <3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
    	};
	};
    gpio3-pa2 {
        gpio3_pa2:gpio3-pa2 {
            rockchip,pins = <3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
    	};
	};
    gpio3-pa3 {
        gpio3_pa3:gpio3-pa3 {
            rockchip,pins = <3 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
    	};
	};
    gpio3-pa5 {
        gpio3_pa5:gpio3-pa5 {
            rockchip,pins = <3 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
    	};
	};
};

/**********SFC**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
// &sdmmc {
