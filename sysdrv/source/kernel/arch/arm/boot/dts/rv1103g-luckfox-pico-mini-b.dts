	// pinctrl-names = "default";
	// pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
// };

/**********ETH**********/
&gmac {
	status = "disabled";
};

/**********USB**********/
&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********SPI**********/
/* SPI0_M0 for oled */
&spi0 {
	status = "okay";
	spidev@0 {
		spi-max-frequency = <50000000>;
	};
};

/**********I2C**********/
/* I2C3_M1 */
&i2c3 {
	status = "disabled";
	clock-frequency = <100000>;
};

/**********UART**********/
/* UART3_M1 for 485 */
&uart3 {
	status = "okay";
};

/* UART4_M1 for ble */
&uart4 {
	status = "okay";
};

/* UART5_M2 for stc */
&uart5 {
	status = "okay";
	pinctrl-0 = <&uart5m2_xfer>;
};

/**********PWM**********/
/* PWM1_M0, for buzzer */
&pwm1 {
	status = "okay";
};
/* PWM0_M0, for 38k */
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0m0_pins>;
};
